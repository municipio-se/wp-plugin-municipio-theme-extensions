#: source/Customizer/HeaderSettings.php
msgid "Header link color"
msgstr "Länkfärg i sidhuvudet"

#: source/Customizer/HeaderSettings.php
msgid "Sets the color of links and icons shown directly in the header."
msgstr "Anger färgen för länkar och ikoner som visas direkt i sidhuvudet."

#: source/Customizer/HeaderSettings.php
msgid "Header link typography"
msgstr "Typografi för länkar i sidhuvudet"

#: source/Customizer/HeaderSettings.php
msgid "Sets the size and weight of links shown directly in the header."
msgstr "Anger storlek och vikt för länkar som visas direkt i sidhuvudet."

#: source/Customizer/MenuSettings.php
msgid "Start secondary menu at level two"
msgstr "Låt sekundärmenyn börja på nivå två"

#: source/Customizer/MenuSettings.php
msgid "Hides level one from the secondary page navigation."
msgstr "Döljer nivå ett i den sekundära sidnavigationen."

#: source/Customizer/MenuSettings.php
msgid "Enabled"
msgstr "Aktiverat"

#: source/Customizer/MenuSettings.php
msgid "Disabled"
msgstr "Inaktiverat"

#: source/Customizer/OnePageSettings.php
msgid "Display text content for One Page template"
msgstr "Visa textinnehåll för One Page-mall"

#: source/Customizer/TypographySettings.php
msgid "Letter Spacing"
msgstr "Teckenavstånd"

#: source/Customizer/DrawerSettings.php
msgid "Light"
msgstr "Ljus"

#: source/Customizer/SecondaryNavigationPosition.php
msgid "Below title"
msgstr "Under rubriken"

#: source/Navigation/PageHideSecondaryMenu.php
msgid "Hide secondary menu"
msgstr "Dölj sekundärmeny"

#: source/Navigation/BelowTitleNavigation.php
msgid "Subpages"
msgstr "Undersidor"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Header breakpoint"
msgstr "Brytpunkt för sidhuvud"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Selects the first screen size that uses the standard desktop header."
msgstr "Väljer den första skärmstorleken som använder standardsidhuvudet för desktop."

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Extra small"
msgstr "Extra liten"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Small"
msgstr "Liten"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Medium"
msgstr "Mellan"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Large"
msgstr "Stor"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Extra large"
msgstr "Extra stor"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Tab menu button size"
msgstr "Knappstorlek för flikmeny"

#: source/Customizer/ResponsiveHeaderSettings.php
msgid "Hero search placeholder"
msgstr "Platshållartext i herosökning"

#: source/Customizer/ContentLayoutSettings.php
msgid "Content layout"
msgstr "Layout för innehåll"

#: source/Customizer/ContentLayoutSettings.php
msgid "Default module width"
msgstr "Standardbredd för moduler"

#: source/Customizer/ContentLayoutSettings.php
msgid "Select the width modules should have when set to “inherit”."
msgstr "Välj den bredd som moduler ska ha när satt till ”ärv”."

#: source/Customizer/ContentLayoutSettings.php
msgid "Content area placement"
msgstr "Placering i innehållsyta"

#: source/Customizer/ContentLayoutSettings.php
msgid "Select how modules in the content area are placed in relation to the article."
msgstr "Välj hur modulerna i innehållsytan ska placeras i förhållande till artikeln."

#: source/Customizer/ContentLayoutSettings.php
msgid "Outside"
msgstr "Utanför"

#: source/Customizer/ContentLayoutSettings.php
msgid "Inside"
msgstr "Inuti"

#: source/Customizer/ContentLayoutSettings.php
msgid "Article content alignment"
msgstr "Justering av artikelinnehåll"

#: source/Customizer/ContentLayoutSettings.php
msgid "Select how the article content should be aligned."
msgstr "Välj hur artikelinnehållet ska justeras."

#: source/Customizer/ContentLayoutSettings.php
msgid "Left"
msgstr "Vänsterställt"

#: source/Customizer/ContentLayoutSettings.php
msgid "Center"
msgstr "Centrerat"
